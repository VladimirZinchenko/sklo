@@ -0,0 +1,58 @@
+<?php
+
+namespace Drupal\Tests\commerce_novaposhta\Unit;
+
+use Drupal\commerce_novaposhta\Element\Novaposhta;
+use Drupal\commerce_novaposhta\Service\NovaposhtaManagerInterface;
+use Drupal\Core\DependencyInjection\ContainerBuilder;
+use Drupal\Core\Form\FormState;
+use Drupal\Core\StringTranslation\TranslationInterface;
+use Drupal\Tests\UnitTestCase;
+
+/**
+ * Tests the Nova Poshta address element compatibility fixes.
+ *
+ * @group commerce_novaposhta
+ */
+class NovaposhtaElementTest extends UnitTestCase {
+
+  /**
+   * Tests scalar defaults and preservation of region metadata.
+   */
+  public function testScalarDefaultsAndRegionData(): void {
+    $manager = $this->createMock(NovaposhtaManagerInterface::class);
+    $manager->method('getRegions')->willReturn([]);
+    $manager->method('extractRegionOptions')->willReturn([]);
+    $translation = $this->createMock(TranslationInterface::class);
+    $translation->method('translate')->willReturnCallback(fn($string) => $string);
+    $container = new ContainerBuilder();
+    $container->set('commerce.novaposhta.manager', $manager);
+    $container->set('string_translation', $translation);
+    \Drupal::setContainer($container);
+
+    $region_data = ['Ref' => 'region-ref'];
+    $city_data = ['Ref' => 'city-ref'];
+    $values = Novaposhta::applyDefaults([
+      'region_data' => $region_data,
+      'city_data' => $city_data,
+    ]);
+    $this->assertSame('', $values['region']);
+    $this->assertSame('', $values['city']);
+    $this->assertSame('', $values['warehouse']);
+
+    $element = [
+      '#value' => $values,
+      '#parents' => ['address_novaposhta'],
+      '#required' => TRUE,
+    ];
+    $form_state = new FormState();
+    $complete_form = [];
+    Novaposhta::processElement($element, $form_state, $complete_form);
+    $state = Novaposhta::getElementState($element['#parents'], $form_state);
+
+    $this->assertSame('', $element['region']['#default_value']);
+    $this->assertSame($region_data, $state['region_data']);
+    $this->assertNotSame($city_data, $state['region_data']);
+  }
+
+}
