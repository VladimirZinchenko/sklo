@@ -0,0 +1,228 @@
+<?php
+
+namespace Drupal\Tests\commerce_novaposhta\Unit;
+
+use Drupal\commerce_novaposhta\Service\NovaposhtaManager;
+use Drupal\commerce_price\Price;
+use Drupal\commerce_shipping\Entity\ShipmentInterface;
+use Drupal\Core\Cache\CacheBackendInterface;
+use Drupal\Core\Config\ConfigFactoryInterface;
+use Drupal\Core\Config\ImmutableConfig;
+use Drupal\Core\Extension\ModuleHandlerInterface;
+use Drupal\Core\Field\FieldItemInterface;
+use Drupal\Core\Field\FieldItemListInterface;
+use Drupal\Core\TypedData\TypedDataInterface;
+use Drupal\physical\Weight;
+use Drupal\profile\Entity\ProfileInterface;
+use Drupal\Tests\UnitTestCase;
+use GuzzleHttp\ClientInterface;
+use PHPUnit\Framework\MockObject\MockObject;
+use Psr\Log\LoggerInterface;
+
+/**
+ * Tests Nova Poshta rate calculation compatibility.
+ *
+ * @group commerce_novaposhta
+ */
+class NovaposhtaRatesTest extends UnitTestCase {
+
+  /**
+   * Tests service mapping and normalized rates.
+   */
+  public function testServiceTypeMapping(): void {
+    $cache = $this->createMock(CacheBackendInterface::class);
+    $cache->method('get')->willReturn(FALSE);
+    $manager = $this->createManager($cache);
+    $service_types = [];
+    $manager->expects($this->exactly(3))
+      ->method('request')
+      ->willReturnCallback(function ($model, $method, array $parameters) use (&$service_types) {
+        $service_types[] = $parameters['ServiceType'];
+        return ['data' => [['Cost' => count($service_types) * 100]]];
+      });
+
+    $rates = $manager->getRates($this->createShipment(), $this->createConfiguration([
+      'Warehouse',
+      'Doors',
+      'Postomat',
+    ]));
+
+    $this->assertSame([
+      'WarehouseWarehouse',
+      'WarehouseDoors',
+      'WarehousePostomat',
+    ], $service_types);
+    $this->assertSame([
+      'Warehouse' => '100',
+      'Doors' => '200',
+      'Postomat' => '300',
+    ], $rates);
+  }
+
+  /**
+   * Tests that disabled services do not cause API requests.
+   */
+  public function testDisabledServiceDoesNotRequestRate(): void {
+    $cache = $this->createMock(CacheBackendInterface::class);
+    $cache->method('get')->willReturn(FALSE);
+    $manager = $this->createManager($cache);
+    $manager->expects($this->once())
+      ->method('request')
+      ->with(
+        $this->anything(),
+        $this->anything(),
+        $this->callback(fn(array $parameters) => $parameters['ServiceType'] === 'WarehouseWarehouse')
+      )
+      ->willReturn(['data' => [['Cost' => 100]]]);
+
+    $rates = $manager->getRates($this->createShipment(), $this->createConfiguration(['Warehouse']));
+    $this->assertSame(['Warehouse' => '100'], $rates);
+  }
+
+  /**
+   * Tests a cache miss followed by a cache hit.
+   */
+  public function testRateCache(): void {
+    $items = [];
+    $cache = $this->createMock(CacheBackendInterface::class);
+    $cache->method('get')->willReturnCallback(function ($cid) use (&$items) {
+      return array_key_exists($cid, $items) ? (object) ['data' => $items[$cid]] : FALSE;
+    });
+    $cache->method('set')->willReturnCallback(function ($cid, $data) use (&$items) {
+      $items[$cid] = $data;
+    });
+    $manager = $this->createManager($cache);
+    $manager->expects($this->once())
+      ->method('request')
+      ->willReturn(['data' => [['Cost' => 125]]]);
+    $configuration = $this->createConfiguration(['Warehouse']);
+    $shipment = $this->createShipment();
+
+    $this->assertSame(['Warehouse' => '125'], $manager->getRates($shipment, $configuration));
+    $this->assertSame(['Warehouse' => '125'], $manager->getRates($shipment, $configuration));
+  }
+
+  /**
+   * Tests that one failed service does not remove other rates.
+   */
+  public function testOneFailedServiceDoesNotRemoveOtherRates(): void {
+    $cache = $this->createMock(CacheBackendInterface::class);
+    $cache->method('get')->willReturn(FALSE);
+    $manager = $this->createManager($cache);
+    $manager->method('request')->willReturnCallback(function ($model, $method, array $parameters) {
+      return $parameters['ServiceType'] === 'WarehouseWarehouse' ? [] : ['data' => [['Cost' => 150]]];
+    });
+
+    $rates = $manager->getRates($this->createShipment(), $this->createConfiguration([
+      'Warehouse',
+      'Doors',
+    ]));
+    $this->assertSame(['Doors' => '150'], $rates);
+  }
+
+  /**
+   * Tests nullable shipment inputs.
+   *
+   * @dataProvider nullableShipmentProvider
+   */
+  public function testNullableShipmentData(bool $profile, bool $weight, bool $declared_value): void {
+    $cache = $this->createMock(CacheBackendInterface::class);
+    $manager = $this->createManager($cache);
+    $manager->expects($this->never())->method('request');
+
+    $this->assertSame([], $manager->getRates(
+      $this->createShipment($profile, $weight, $declared_value),
+      $this->createConfiguration(['Warehouse'])
+    ));
+  }
+
+  /**
+   * Provides nullable shipment combinations.
+   */
+  public static function nullableShipmentProvider(): array {
+    return [
+      'profile' => [FALSE, TRUE, TRUE],
+      'weight' => [TRUE, FALSE, TRUE],
+      'declared value' => [TRUE, TRUE, FALSE],
+    ];
+  }
+
+  /**
+   * Tests that a response without Cost is skipped.
+   */
+  public function testResponseWithoutCostIsSkipped(): void {
+    $cache = $this->createMock(CacheBackendInterface::class);
+    $cache->method('get')->willReturn(FALSE);
+    $manager = $this->createManager($cache);
+    $manager->expects($this->once())
+      ->method('request')
+      ->willReturn(['data' => [['AssessedCost' => 100]]]);
+
+    $this->assertSame([], $manager->getRates(
+      $this->createShipment(),
+      $this->createConfiguration(['Warehouse'])
+    ));
+  }
+
+  /**
+   * Creates a manager with a mocked API request method.
+   */
+  private function createManager(CacheBackendInterface $cache): NovaposhtaManager&MockObject {
+    $config = $this->createMock(ImmutableConfig::class);
+    $config->method('get')->willReturn('');
+    $config_factory = $this->createMock(ConfigFactoryInterface::class);
+    $config_factory->method('get')->willReturn($config);
+
+    return $this->getMockBuilder(NovaposhtaManager::class)
+      ->setConstructorArgs([
+        $config_factory,
+        $this->createMock(ClientInterface::class),
+        $this->createMock(ModuleHandlerInterface::class),
+        $cache,
+        $this->createMock(LoggerInterface::class),
+      ])
+      ->onlyMethods(['request'])
+      ->getMock();
+  }
+
+  /**
+   * Creates a shipment mock with Nova Poshta address data.
+   */
+  private function createShipment(bool $with_profile = TRUE, bool $with_weight = TRUE, bool $with_declared_value = TRUE): ShipmentInterface {
+    $shipment = $this->createMock(ShipmentInterface::class);
+    if ($with_profile) {
+      $city = $this->createMock(TypedDataInterface::class);
+      $city->method('getValue')->willReturn('recipient-city');
+      $address = $this->createMock(FieldItemInterface::class);
+      $address->method('get')->with('city')->willReturn($city);
+      $address_field = $this->createMock(FieldItemListInterface::class);
+      $address_field->method('isEmpty')->willReturn(FALSE);
+      $address_field->method('first')->willReturn($address);
+      $profile = $this->createMock(ProfileInterface::class);
+      $profile->method('hasField')->with('address_novaposhta')->willReturn(TRUE);
+      $profile->method('get')->with('address_novaposhta')->willReturn($address_field);
+      $shipment->method('getShippingProfile')->willReturn($profile);
+    }
+    else {
+      $shipment->method('getShippingProfile')->willReturn(NULL);
+    }
+    $shipment->method('getWeight')->willReturn($with_weight ? new Weight('1', 'kg') : NULL);
+    $shipment->method('getTotalDeclaredValue')->willReturn($with_declared_value ? new Price('100', 'UAH') : NULL);
+    return $shipment;
+  }
+
+  /**
+   * Creates shipping method configuration.
+   */
+  private function createConfiguration(array $services): array {
+    return [
+      'services' => $services,
+      'options' => [
+        'novaposhta' => [
+          'city' => 'sender-city',
+        ],
+      ],
+    ];
+  }
+
+}
